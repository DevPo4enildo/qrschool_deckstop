<Window x:Class="qrschool_deckstop.Views.EditComputerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование компьютера" Height="600" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Информация о компьютере" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Код:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCode" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Инв. номер:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtInventoryNo" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Бренд:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtBrand" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Модель:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtModel" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Диагональ (дюймы):" VerticalAlignment="Center"/>
        <TextBox x:Name="txtDiagonal" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Серийный номер:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtSerialNumber" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Статус:" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbStatus" Grid.Row="7" Grid.Column="1" Margin="5">
            <ComboBoxItem>active</ComboBoxItem>
            <ComboBoxItem>repair</ComboBoxItem>
            <ComboBoxItem>written_off</ComboBoxItem>
            <ComboBoxItem>reserved</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Стоимость:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtCost" Grid.Row="8" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Дата покупки:" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpPurchaseDate" Grid.Row="9" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Гарантия до:" VerticalAlignment="Center"/>
        <DatePicker x:Name="dpWarrantyUntil" Grid.Row="10" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Text="Комментарий:" VerticalAlignment="Top"/>
        <TextBox x:Name="txtComment" Grid.Row="11" Grid.Column="1" Height="60" TextWrapping="Wrap" Margin="5"/>

        <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Click="BtnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Click="BtnCancel_Click" Background="#666"/>
        </StackPanel>
    </Grid>
</Window>
