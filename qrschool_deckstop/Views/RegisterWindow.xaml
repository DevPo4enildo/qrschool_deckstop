<Window x:Class="qrschool_deckstop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация - Инвентарный учет" Height="450" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Регистрация" FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Логин:" FontSize="14" Margin="0,0,0,5"/>
        <TextBox x:Name="txtUsername" Grid.Row="2" FontSize="14" Height="35"/>

        <TextBlock Grid.Row="3" Text="Пароль:" FontSize="14" Margin="0,10,0,5"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="4" FontSize="14" Height="35"/>

        <TextBlock Grid.Row="5" Text="Полное имя:" FontSize="14" Margin="0,10,0,5"/>
        <TextBox x:Name="txtFullName" Grid.Row="6" FontSize="14" Height="35"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnCreate" Content="Создать" Width="100" Height="35" 
                    FontSize="14" Click="BtnCreate_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" 
                    FontSize="14" Click="BtnCancel_Click" Background="#666"/>
        </StackPanel>

        <TextBlock x:Name="txtError" Grid.Row="8" Text="" Foreground="Red" 
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>