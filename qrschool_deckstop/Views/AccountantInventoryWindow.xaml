<Window x:Class="qrschool_deckstop.Views.AccountantInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инвентарный учет - Бухгалтер" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#007ACC" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Инвентарный учет" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="btnLogout" Content="Выход" Width="80" Click="BtnLogout_Click" Background="#666" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Панель управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" Background="#F0F0F0">
            <TextBlock Text="Тип техники:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="cmbEquipmentType" Width="150" SelectionChanged="CmbEquipmentType_SelectionChanged" Margin="5">
                <ComboBoxItem Content="Компьютеры" IsSelected="True"/>
                <ComboBoxItem Content="Мониторы"/>
                <ComboBoxItem Content="Периферия"/>
            </ComboBox>

            <Separator Width="20" Visibility="Hidden"/>

            <Button x:Name="btnAdd" Content="➕ Добавить" Width="100" Click="BtnAdd_Click"/>
            <Button x:Name="btnEdit" Content="✏ Редактировать" Width="120" Click="BtnEdit_Click"/>
            <Button x:Name="btnDelete" Content="🗑 Удалить" Width="100" Click="BtnDelete_Click" Background="#D32F2F"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" Width="100" Click="BtnRefresh_Click"/>
            <Button x:Name="btnGenerateQr" Content="📱 Сгенерировать QR" Width="150" Click="BtnGenerateQr_Click" Background="#4CAF50"/>
        </StackPanel>

        <!-- DataGrid для отображения данных -->
        <DataGrid x:Name="dgInventory" Grid.Row="2" Margin="10" 
                  AutoGenerateColumns="True" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"/>
    </Grid>
</Window>
