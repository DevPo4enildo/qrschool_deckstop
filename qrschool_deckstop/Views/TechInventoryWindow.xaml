<Window x:Class="qrschool_deckstop.Views.TechInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инвентарный учет - Технический специалист" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Инвентарный учет - Технический специалист" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <Button x:Name="btnLogout" Content="Выход" Width="80" Click="BtnLogout_Click" Background="#666"/>
            </StackPanel>
        </Border>

        <!-- Панель управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" Background="#F0F0F0">
            <TextBlock Text="Тип техники:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="cmbEquipmentType" Width="150" SelectionChanged="CmbEquipmentType_SelectionChanged" Margin="5">
                <ComboBoxItem Content="Компьютеры" IsSelected="True"/>
                <ComboBoxItem Content="Мониторы"/>
                <ComboBoxItem Content="Периферия"/>
            </ComboBox>

            <Separator Width="20" Visibility="Hidden"/>

            <Button x:Name="btnEdit" Content="✏ Редактировать" Width="120" Click="BtnEdit_Click"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" Width="100" Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- DataGrid для отображения данных (только чтение) -->
        <DataGrid x:Name="dgInventory" Grid.Row="2" Margin="10" 
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Инв. номер" Binding="{Binding InventoryNo}" Width="150"/>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="100"/>
                <DataGridTextColumn Header="Кабинет" Binding="{Binding RoomName}" Width="120"/>
                <DataGridTextColumn Header="ID компьютера" Binding="{Binding ComputerId}" Width="110"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="150"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="150"/>
                <DataGridTextColumn Header="Диагональ" Binding="{Binding DiagonalInch}" Width="100"/>
                <DataGridTextColumn Header="Серийный №" Binding="{Binding SerialNumber}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="180"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost}" Width="100"/>
                <DataGridTextColumn Header="Дата покупки" Binding="{Binding PurchaseDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                <DataGridTextColumn Header="Гарантия до" Binding="{Binding WarrantyUntil, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                <DataGridTextColumn Header="Ответственный" Binding="{Binding ResponsibleEmployee}" Width="150"/>
                <DataGridTextColumn Header="Заметки" Binding="{Binding Notes}" Width="180"/>
                <DataGridTextColumn Header="Синхронизация" Binding="{Binding SyncStatus}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
